{
  "ConnectionStrings": {
    "Postgres": ""
  },
  "Jwt": {
    "Issuer": "LocalSIEM",
    "Audience": "LocalSIEM",
    "Key": "",
    "LifetimeMinutes": 60
  },
  "Seed": {
    "AdminUser": "admin",
    "AdminPassword": ""
  },
  "Detection": {
    "QueueCapacity": 10000
  },
  "RateLimits": {
    "LoginPerMinute": 5,
    "IngestEventsPerSecond": 1000
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
